             <button class="btn btn-outline-warning btn-sm" onclick="archiveWikiPage(${pageData.id}, '${pageData.title.replace(/'/g, "\\'")}')">
               <i class="bi bi-archive me-1"></i>Archive Page
             </button>
           </div>
        </div>

        ${pageData.tags && pageData.tags.length > 0 ? `
          <div class="mb-4">
            <strong>Tags:</strong>
            ${pageData.tags.map(tag => `<span class="badge bg-light text-dark me-1">${tag}</span>`).join('')}
          </div>
