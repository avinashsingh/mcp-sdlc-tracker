<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    .status-badge {
      font-size: 0.75em;
      padding: 0.25em 0.5em;
    }
    .entity-card {
      transition: all 0.2s ease;
    }
    .entity-card:hover {
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .phase-indicator {
      font-size: 0.8em;
      opacity: 0.8;
    }
    .last-modified {
      font-size: 0.75em;
      color: #6c757d;
    }
    .hierarchy-level-1 { margin-left: 0; }
    .hierarchy-level-2 { margin-left: 2rem; }
    .hierarchy-level-3 { margin-left: 4rem; }
    .hierarchy-level-4 { margin-left: 6rem; }
    .markdown-content {
      line-height: 1.6;
    }
    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
      margin-top: 1rem;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .markdown-content p {
      margin-bottom: 1rem;
    }
    .markdown-content ul,
    .markdown-content ol {
      margin-bottom: 1rem;
      padding-left: 2rem;
    }
    .markdown-content li {
      margin-bottom: 0.25rem;
    }
    .markdown-content code {
      background-color: #f8f9fa;
      padding: 0.125rem 0.25rem;
      border-radius: 0.25rem;
      font-family: 'Courier New', monospace;
      font-size: 0.875em;
    }
    .markdown-content pre {
      background-color: #f8f9fa;
      padding: 1rem;
      border-radius: 0.25rem;
      overflow-x: auto;
      margin-bottom: 1rem;
    }
    .markdown-content pre code {
      background-color: transparent;
      padding: 0;
    }
    .markdown-content blockquote {
      border-left: 4px solid #dee2e6;
      padding-left: 1rem;
      margin-bottom: 1rem;
      color: #6c757d;
    }
    .markdown-content table {
      width: 100%;
      margin-bottom: 1rem;
      border-collapse: collapse;
    }
    .markdown-content th,
    .markdown-content td {
      padding: 0.5rem;
      border: 1px solid #dee2e6;
    }
    .markdown-content th {
      background-color: #f8f9fa;
      font-weight: 600;
    }
  </style>
</head>
<body class="bg-light">
  <div class="container-fluid py-4">
    <div class="row">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="h3 mb-0">
            <i class="bi bi-kanban text-primary me-2"></i>
            SDLC Tracker Dashboard
          </h1>
          <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
          </button>
        </div>

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs mb-4" id="mainTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sdlc-tab" data-bs-toggle="tab" data-bs-target="#sdlc-panel" type="button" role="tab">
              <i class="bi bi-kanban me-2"></i>SDLC Tracker
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="wiki-tab" data-bs-toggle="tab" data-bs-target="#wiki-panel" type="button" role="tab" onclick="showWikiIndex()">
              <i class="bi bi-book me-2"></i>Wiki
            </button>
          </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="mainTabContent">
          <!-- SDLC Tab -->
          <div class="tab-pane fade show active" id="sdlc-panel" role="tabpanel">
            <div id="sdlc-loading" class="text-center py-5">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2 text-muted">Loading SDLC data...</p>
            </div>

            <div id="sdlc-content" class="d-none">
              <!-- SDLC Hierarchy will be rendered here -->
            </div>
          </div>

          <!-- Wiki Tab -->
          <div class="tab-pane fade" id="wiki-panel" role="tabpanel">
            <div id="wiki-loading" class="text-center py-5">
              <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2 text-muted">Loading wiki pages...</p>
            </div>

            <div id="wiki-content" class="d-none">
              <!-- Wiki pages will be rendered here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/lib/marked.umd.js"></script>
  <script>
    let epicsData = [];
    let wikiData = [];
    let currentRoute = '/';

    // Client-side routing
    const routes = {
      '/': showDashboard,
      '/epic/:id': showEpicDetails,
      '/story/:id': showStoryDetails,
      '/task/:id': showTaskDetails,
      '/bug/:id': showBugDetails,
      '/test-case/:id': showTestCaseDetails,
      '/wiki': showWikiIndex,
      '/wiki/:id': showWikiPage
    };

    function navigateTo(path) {
      window.history.pushState(null, '', path);
      currentRoute = path;
      renderRoute(path);
    }

    function renderRoute(path) {
      const route = Object.keys(routes).find(route => {
        const routeRegex = new RegExp('^' + route.replace(/:\w+/g, '(\\w+)') + '$');
        return routeRegex.test(path);
      });

      if (route) {
        const routeHandler = routes[route];
        const matches = path.match(new RegExp(route.replace(/:\w+/g, '(\\w+)')));
        const params = matches ? matches.slice(1) : [];
        routeHandler.apply(null, params);
      } else {
        showDashboard();
      }
    }

    // Handle browser back/forward
    window.addEventListener('popstate', () => {
      const path = window.location.pathname;
      renderRoute(path);
    });

    function renderMarkdown(text) {
      if (!text) return '';
      return marked.parse(text, {
        breaks: true,
        gfm: true
      });
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const diffTime = Math.abs(now - date);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      if (diffDays === 1) return 'today';
      if (diffDays === 2) return 'yesterday';
      if (diffDays <= 7) return `${diffDays - 1} days ago`;
      return date.toLocaleDateString();
    }

    function getStatusBadge(status) {
      const statusMap = {
        'New': 'secondary',
        'Open': 'info',
        'In Progress': 'primary',
        'Review': 'warning',
        'QA': 'info',
        'UAT': 'warning',
        'Fixed': 'success',
        'Closed': 'success',
        'Passed': 'success',
        'Failed': 'danger',
        'Critical': 'danger',
        'High': 'danger',
        'Medium': 'warning',
        'Low': 'secondary'
      };
      return statusMap[status] || 'secondary';
    }

    function getEntityIcon(type) {
      const iconMap = {
        'epic': 'bi-trophy',
        'user_story': 'bi-card-text',
        'task': 'bi-check-circle',
        'bug': 'bi-bug',
        'test_case': 'bi-clipboard-check'
      };
      return iconMap[type] || 'bi-circle';
    }

    function getEntityRoute(type) {
      const routeMap = {
        'epic': 'epic',
        'user_story': 'story',
        'task': 'task',
        'bug': 'bug',
        'test_case': 'test-case'
      };
      return routeMap[type] || type;
    }

    function createEntityCard(entity, type, level = 1, hasChildren = false) {
      const badgeClass = getStatusBadge(entity.status);
      const iconClass = getEntityIcon(type);
      const phaseInfo = entity.phase ? `<span class="phase-indicator ms-2"><i class="bi bi-diagram-3"></i> ${entity.phase}</span>` : '';
      const lastModified = formatDate(entity.updated_at);
      const entityId = `${type}_${entity.id}`;
      const route = getEntityRoute(type);

      // Comments indicator
      const commentCount = entity.comment_count || 0;
      const commentsInfo = commentCount > 0 ?
        `<span class="text-muted small ms-2 comments-link" style="cursor: pointer;" onclick="event.stopPropagation(); showComments('${type}', ${entity.id})" title="Click to view comments">
          <i class="bi bi-chat me-1"></i>${commentCount}
        </span>` : '';

      // Dependencies indicator (for user stories and epics)
      let dependenciesInfo = '';
      if ((type === 'user_story' || type === 'epic') && entity.dependencies && entity.dependencies.length > 0) {
        const entityType = type === 'user_story' ? 'storie' : 'epic';
        dependenciesInfo = `<span class="text-muted small ms-2" title="Depends on ${entity.dependencies.length} other ${entityType}(s)">
          <i class="bi bi-arrow-right-circle me-1"></i>${entity.dependencies.length}
        </span>`;
      }

      // Expand/collapse button
      const expandButton = hasChildren ?
        `<button class="btn btn-sm btn-outline-secondary me-2 expand-btn" data-bs-toggle="collapse" data-bs-target="#collapse_${entityId}" aria-expanded="true" onclick="event.stopPropagation()">
          <i class="bi bi-dash"></i>
        </button>` : '';

      return `
        <div class="card entity-card mb-2 hierarchy-level-${level}" onclick="navigateTo('/${route}/${entity.id}')" style="cursor: pointer;">
          <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center flex-grow-1">
                ${expandButton}
                <i class="bi ${iconClass} text-muted me-2"></i>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center mb-1">
                    <span class="fw-medium text-truncate">${entity.title || entity.description || `ID: ${entity.id}`}</span>
                    <span class="badge bg-${badgeClass} ms-2 status-badge">${entity.status}</span>
                    ${phaseInfo}
                    ${dependenciesInfo}
                    ${commentsInfo}
                  </div>
                  <div class="last-modified">
                    <i class="bi bi-clock me-1"></i>
                    Modified ${lastModified}
                  </div>
                </div>
              </div>
              ${entity.user_story_count !== undefined || entity.task_count !== undefined || entity.bug_count !== undefined || entity.test_case_count !== undefined ?
                `<div class="text-muted small">
                  ${entity.user_story_count !== undefined ? `<i class="bi bi-card-text me-1"></i>${entity.user_story_count}` : ''}
                  ${entity.task_count !== undefined ? `<i class="bi bi-check-circle ms-2 me-1"></i>${entity.task_count}` : ''}
                  ${entity.bug_count !== undefined ? `<i class="bi bi-bug ms-2 me-1"></i>${entity.bug_count}` : ''}
                  ${entity.test_case_count !== undefined ? `<i class="bi bi-clipboard-check ms-2 me-1"></i>${entity.test_case_count}` : ''}
                </div>` : ''}
            </div>
          </div>
        </div>
      `;
    }

    function renderSDLC() {
      const content = document.getElementById('sdlc-content');
      let html = '';

      epicsData.forEach(epic => {
        const hasChildren = epic.userStories && epic.userStories.length > 0;
        html += createEntityCard(epic, 'epic', 1, hasChildren);

        if (hasChildren) {
          const epicCollapseId = `collapse_epic_${epic.id}`;
          html += `<div class="collapse show" id="${epicCollapseId}">`;
          html += `<div class="ms-4">`; // Indent children

          epic.userStories.forEach(userStory => {
            const hasUserStoryChildren = (userStory.tasks && userStory.tasks.length > 0) ||
                                       (userStory.bugs && userStory.bugs.length > 0) ||
                                       (userStory.testCases && userStory.testCases.length > 0);
            html += createEntityCard(userStory, 'user_story', 2, hasUserStoryChildren);

            if (hasUserStoryChildren) {
              const userStoryCollapseId = `collapse_user_story_${userStory.id}`;
              html += `<div class="collapse show" id="${userStoryCollapseId}">`;
              html += `<div class="ms-4">`; // Indent children

              // Tasks
              if (userStory.tasks && userStory.tasks.length > 0) {
                userStory.tasks.forEach(task => {
                  html += createEntityCard(task, 'task', 3, false);
                });
              }

              // Bugs
              if (userStory.bugs && userStory.bugs.length > 0) {
                userStory.bugs.forEach(bug => {
                  html += createEntityCard(bug, 'bug', 3, false);
                });
              }

              // Test Cases
              if (userStory.testCases && userStory.testCases.length > 0) {
                userStory.testCases.forEach(testCase => {
                  html += createEntityCard(testCase, 'test_case', 3, false);
                });
              }

              html += `</div>`; // End user story children indent
              html += `</div>`; // End user story collapse
            }
          });

          html += `</div>`; // End epic children indent
          html += `</div>`; // End epic collapse
        }
      });

      content.innerHTML = html;

      // Add event listeners for expand/collapse buttons
      document.querySelectorAll('.expand-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const icon = this.querySelector('i');
          if (icon) {
            icon.classList.toggle('bi-dash');
            icon.classList.toggle('bi-plus');
          }
        });
      });
    }

    // Route handlers
    function showDashboard() {
      document.title = 'SDLC Tracker Dashboard';

      // Switch to SDLC tab
      const sdlcTab = document.getElementById('sdlc-tab');
      const wikiTab = document.getElementById('wiki-tab');
      if (sdlcTab && wikiTab) {
        sdlcTab.classList.add('active');
        wikiTab.classList.remove('active');
        document.getElementById('sdlc-panel').classList.add('show', 'active');
        document.getElementById('wiki-panel').classList.remove('show', 'active');
      }

      renderSDLC();
    }

    async function showEpicDetails(epicId) {
      try {
        document.getElementById('sdlc-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading epic details...</p>
          </div>
        `;

        const response = await fetch(`/api/epic/${epicId}`);
        if (!response.ok) {
          throw new Error('Failed to load epic details');
        }

        const epic = await response.json();
        renderEntityDetail(epic, 'epic');
      } catch (error) {
        console.error('Error loading epic details:', error);
        document.getElementById('sdlc-content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load epic details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showStoryDetails(storyId) {
      try {
        document.getElementById('sdlc-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading user story details...</p>
          </div>
        `;

        const response = await fetch(`/api/story/${storyId}`);
        if (!response.ok) {
          throw new Error('Failed to load story details');
        }

        const story = await response.json();
        renderEntityDetail(story, 'user_story');
      } catch (error) {
        console.error('Error loading story details:', error);
        document.getElementById('sdlc-content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load user story details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showTaskDetails(taskId) {
      try {
        document.getElementById('sdlc-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading task details...</p>
          </div>
        `;

        const response = await fetch(`/api/task/${taskId}`);
        if (!response.ok) {
          throw new Error('Failed to load task details');
        }

        const task = await response.json();
        renderEntityDetail(task, 'task');
      } catch (error) {
        console.error('Error loading task details:', error);
        document.getElementById('sdlc-content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load task details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showBugDetails(bugId) {
      try {
        document.getElementById('sdlc-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading bug details...</p>
          </div>
        `;

        const response = await fetch(`/api/bug/${bugId}`);
        if (!response.ok) {
          throw new Error('Failed to load bug details');
        }

        const bug = await response.json();
        renderEntityDetail(bug, 'bug');
      } catch (error) {
        console.error('Error loading bug details:', error);
        document.getElementById('sdlc-content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load bug details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showTestCaseDetails(testCaseId) {
      try {
        document.getElementById('sdlc-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading test case details...</p>
          </div>
        `;

        const response = await fetch(`/api/test-case/${testCaseId}`);
        if (!response.ok) {
          throw new Error('Failed to load test case details');
        }

        const testCase = await response.json();
        renderEntityDetail(testCase, 'test_case');
      } catch (error) {
        console.error('Error loading test case details:', error);
        document.getElementById('sdlc-content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load test case details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    function renderEntityDetail(entity, entityType) {
      const statusBadge = getStatusBadge(entity.status);
      const entityIcon = getEntityIcon(entityType);
      const title = entity.title || entity.description || `ID: ${entity.id}`;

      document.title = `${title} - SDLC Tracker`;

      let attributesHtml = '';
      let relationshipsHtml = '';

      // Entity-specific attributes
      switch (entityType) {
        case 'epic':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Owner:</strong> ${entity.owner || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>User Stories:</strong> ${entity.user_story_count || 0}
              </div>
              ${entity.archived ? `
                <div class="col-md-6">
                  <strong>Archived:</strong>
                  <span class="badge bg-warning">Yes</span>
                  ${entity.archive_reason ? `<br><small class="text-muted">Reason: ${entity.archive_reason}</small>` : ''}
                </div>
              ` : ''}
            </div>
          `;
          break;

        case 'user_story':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Story Points:</strong> ${entity.story_points || 'Not set'}
              </div>
              <div class="col-md-6">
                <strong>Current Owner:</strong> ${entity.current_owner || 'Not assigned'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Epic:</strong> ${entity.epic_id ? `<a href="#" onclick="navigateTo('/epic/${entity.epic_id}')">Epic #${entity.epic_id}</a>` : 'None'}
              </div>
            </div>
            ${entity.acceptance_criteria ? `
              <div class="mb-3">
                <strong>Acceptance Criteria:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.acceptance_criteria}</div>
              </div>
            ` : ''}
            <div class="row mb-3">
              <div class="col-md-4">
                <strong>Tasks:</strong> ${entity.task_count || 0}
              </div>
              <div class="col-md-4">
                <strong>Bugs:</strong> ${entity.bug_count || 0}
              </div>
              <div class="col-md-4">
                <strong>Test Cases:</strong> ${entity.test_case_count || 0}
              </div>
            </div>
            ${entity.archived ? `
              <div class="mb-3">
                <strong>Archived:</strong>
                <span class="badge bg-warning ms-2">Yes</span>
                ${entity.archive_reason ? `<br><small class="text-muted">Reason: ${entity.archive_reason}</small>` : ''}
              </div>
            ` : ''}
          `;
          break;

        case 'task':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Estimated Hours:</strong> ${entity.estimated_hours || 'Not set'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Actual Hours:</strong> ${entity.actual_hours || 'Not set'}
              </div>
              <div class="col-md-6">
                <strong>User Story:</strong> ${entity.user_story_id ? `<a href="#" onclick="navigateTo('/story/${entity.user_story_id}')">Story #${entity.user_story_id}</a>` : 'None'}
              </div>
            </div>
          `;
          break;

        case 'bug':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Severity:</strong>
                <span class="badge bg-${getStatusBadge(entity.severity)}">${entity.severity}</span>
              </div>
              <div class="col-md-6">
                <strong>Reported By:</strong> ${entity.reported_by || 'Unknown'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Created By:</strong> ${entity.created_by || 'Unknown'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>User Story:</strong> ${entity.user_story_id ? `<a href="#" onclick="navigateTo('/story/${entity.user_story_id}')">Story #${entity.user_story_id}</a>` : 'None'}
              </div>
              <div class="col-md-6">
                <strong>Task:</strong> ${entity.task_id ? `<a href="#" onclick="navigateTo('/task/${entity.task_id}')">Task #${entity.task_id}</a>` : 'None'}
              </div>
            </div>
          `;
          break;

        case 'test_case':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>User Story:</strong> ${entity.user_story_id ? `<a href="#" onclick="navigateTo('/story/${entity.user_story_id}')">Story #${entity.user_story_id}</a>` : 'None'}
              </div>
            </div>
            ${entity.preconditions ? `
              <div class="mb-3">
                <strong>Preconditions:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.preconditions}</div>
              </div>
            ` : ''}
            ${entity.steps ? `
              <div class="mb-3">
                <strong>Steps:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.steps}</div>
              </div>
            ` : ''}
            ${entity.expected_result ? `
              <div class="mb-3">
                <strong>Expected Result:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.expected_result}</div>
              </div>
            ` : ''}
          `;
          break;
      }

      const html = `
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="#" onclick="navigateTo('/')">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
              ${title}
            </li>
          </ol>
        </nav>

        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <div>
              <h2 class="h4 mb-1">
                <i class="bi ${entityIcon} me-2"></i>
                ${title}
              </h2>
              <div class="text-muted small">
                <i class="bi bi-tag me-1"></i>${entityType.replace('_', ' ')} #${entity.id}
                <span class="badge bg-${statusBadge} ms-2">${entity.status}</span>
                ${entity.phase ? `<span class="badge bg-info ms-1">${entity.phase}</span>` : ''}
              </div>
            </div>
            <div class="text-end">
              <div class="small text-muted">
                Created: ${formatDate(entity.created_at)}<br>
                Updated: ${formatDate(entity.updated_at)}
              </div>
            </div>
          </div>

          <div class="card-body">
            ${entity.description ? `
              <div class="mb-4">
                <h6>Description</h6>
                <div class="markdown-content">${renderMarkdown(entity.description)}</div>
              </div>
            ` : ''}

            ${attributesHtml}

            ${entity.dependencies && entity.dependencies.length > 0 ? `
              <div class="mb-3">
                <strong>Dependencies:</strong>
                <div class="mt-2">
                  ${entity.dependencies.map(depId => {
                    const route = entityType === 'user_story' ? 'story' : 'epic';
                    const label = entityType === 'user_story' ? 'Story' : 'Epic';
                    return `<a href="#" onclick="navigateTo('/${route}/${depId}')" class="badge bg-info me-1">${label} #${depId}</a>`;
                  }).join('')}
                </div>
              </div>
            ` : ''}

            ${(entity.dependent_stories && entity.dependent_stories.length > 0) || (entity.dependent_epics && entity.dependent_epics.length > 0) ? `
              <div class="mb-3">
                <strong>Depended By:</strong>
                <div class="mt-2">
                  ${[
                    ...(entity.dependent_stories || []).map(depId => `<a href="#" onclick="navigateTo('/story/${depId}')" class="badge bg-secondary me-1">Story #${depId}</a>`),
                    ...(entity.dependent_epics || []).map(depId => `<a href="#" onclick="navigateTo('/epic/${depId}')" class="badge bg-secondary me-1">Epic #${depId}</a>`)
                  ].join('')}
                </div>
              </div>
            ` : ''}
          </div>
        </div>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i class="bi bi-chat me-2"></i>
              Comments
            </h5>
            <button class="btn btn-sm btn-outline-primary" onclick="loadComments('${entityType}', ${entity.id})">
              <i class="bi bi-arrow-clockwise me-1"></i>
              Refresh
            </button>
          </div>
          <div class="card-body">
            <div id="comments-content">
              <div class="text-center py-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                  <span class="visually-hidden">Loading comments...</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;

      document.getElementById('sdlc-content').innerHTML = html;
      loadComments(entityType, entity.id);
    }

    async function loadComments(entityType, entityId) {
      try {
        const response = await fetch(`/api/comments/${entityType}/${entityId}`);
        const comments = await response.json();

        const commentsHtml = comments.length === 0
          ? '<p class="text-muted mb-0">No comments yet.</p>'
          : comments.map(comment => `
              <div class="comment-item mb-3 p-3 bg-light rounded">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <strong class="text-primary">${comment.author}</strong>
                  <small class="text-muted">${formatDate(comment.created_at)}</small>
                </div>
                <div class="markdown-content">${renderMarkdown(comment.comment_text)}</div>
              </div>
            `).join('');

        document.getElementById('comments-content').innerHTML = commentsHtml;
      } catch (error) {
        console.error('Error loading comments:', error);
        document.getElementById('comments-content').innerHTML =
          '<div class="alert alert-warning">Failed to load comments.</div>';
      }
    }

    async function loadData() {
      try {
        // Load SDLC data
        document.getElementById('sdlc-loading').classList.remove('d-none');
        document.getElementById('sdlc-content').classList.add('d-none');

        const response = await fetch('/api/epics');
        if (!response.ok) {
          throw new Error('Failed to load epics data');
        }

        const data = await response.json();
        epicsData = data || [];

        document.getElementById('sdlc-loading').classList.add('d-none');
        document.getElementById('sdlc-content').classList.remove('d-none');

        // Load wiki data
        try {
          window.wikiData = await loadWikiData();
        } catch (wikiError) {
          console.warn('Failed to load wiki data:', wikiError);
          window.wikiData = [];
        }

        // Check if we're on the dashboard route
        if (window.location.pathname === '/' || window.location.pathname === '/dashboard') {
          renderSDLC();
        }
      } catch (error) {
        document.getElementById('sdlc-loading').innerHTML = `
          <div class="alert alert-danger text-center">
            <i class="bi bi-exclamation-triangle display-4 mb-3"></i>
            <h5>Failed to load SDLC data</h5>
            <p>Please check if the database is initialized.</p>
          </div>
        `;
        console.error('Error loading data:', error);
      }
    }

    // Wiki functions
    async function loadWikiData() {
      try {
        const response = await fetch('/api/wiki');
        if (!response.ok) {
          throw new Error('Failed to load wiki data');
        }
        return await response.json();
      } catch (error) {
        console.error('Error loading wiki data:', error);
        throw error;
      }
    }

    function showWikiIndex() {
      document.title = 'Wiki - SDLC Tracker';

      // Switch to wiki tab
      const wikiTab = document.getElementById('wiki-tab');
      const sdlcTab = document.getElementById('sdlc-tab');
      if (wikiTab && sdlcTab) {
        wikiTab.classList.add('active');
        sdlcTab.classList.remove('active');
        document.getElementById('wiki-panel').classList.add('show', 'active');
        document.getElementById('sdlc-panel').classList.remove('show', 'active');
      }

      // Use already loaded wiki data if available, otherwise load it
      if (window.wikiData && window.wikiData.length >= 0) {
        renderWikiIndex(window.wikiData);
      } else {
        loadWikiData().then(wikiPages => {
          window.wikiData = wikiPages;
          renderWikiIndex(wikiPages);
        }).catch(error => {
          document.getElementById('wiki-content').innerHTML = `
            <div class="alert alert-danger">
              <h5>Failed to load wiki pages</h5>
              <p>${error.message}</p>
            </div>
          `;
        });
      }
    }

    function renderWikiIndex(wikiPages) {
      const content = document.getElementById('wiki-content');

      if (wikiPages.length === 0) {
        content.innerHTML = `
          <div class="text-center py-5">
            <i class="bi bi-book display-1 text-muted mb-3"></i>
            <h3>No Wiki Pages Yet</h3>
            <p class="text-muted">Create your first wiki page to document processes, guides, and knowledge.</p>
            <button class="btn btn-primary" onclick="createWikiPage()">
              <i class="bi bi-plus-circle me-2"></i>Create First Wiki Page
            </button>
          </div>
        `;
      } else {
        const wikiCards = wikiPages.map(page => `
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card entity-card h-100">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title mb-0">
                    <i class="bi bi-book me-2 text-info"></i>
                    <a href="#" onclick="navigateTo('/wiki/${page.id}')" class="text-decoration-none">
                      ${page.title}
                    </a>
                  </h5>
                  <span class="badge bg-${page.status === 'Published' ? 'success' : 'warning'}">${page.status}</span>
                </div>

                ${page.summary ? `<p class="card-text text-muted small">${page.summary}</p>` : ''}

                <div class="d-flex justify-content-between align-items-center mt-3">
                  <small class="text-muted">
                    <i class="bi bi-tag me-1"></i>${page.category || 'Uncategorized'}
                  </small>
                  <small class="text-muted">
                    <i class="bi bi-chat me-1"></i>${page.comment_count || 0}
                  </small>
                </div>

                ${page.tags && page.tags.length > 0 ? `
                  <div class="mt-2">
                    ${page.tags.map(tag => `<span class="badge bg-light text-dark me-1">${tag}</span>`).join('')}
                  </div>
                ` : ''}

                <div class="mt-3">
                  <button class="btn btn-sm btn-outline-primary" onclick="navigateTo('/wiki/${page.id}')">
                    <i class="bi bi-eye me-1"></i>View
                  </button>
                </div>
              </div>
            </div>
          </div>
        `).join('');

        content.innerHTML = `
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="mb-0">
              <i class="bi bi-book me-2 text-info"></i>Wiki Pages
            </h4>
            <button class="btn btn-primary" onclick="createWikiPage()">
              <i class="bi bi-plus-circle me-2"></i>New Wiki Page
            </button>
          </div>

          <div class="row">
            ${wikiCards}
          </div>
        `;
      }

      // Show content, hide loading
      document.getElementById('wiki-loading').classList.add('d-none');
      content.classList.remove('d-none');
    }

    async function showWikiPage(pageId) {
      try {
        document.title = `Wiki Page - SDLC Tracker`;

        // Switch to wiki tab
        const wikiTab = document.getElementById('wiki-tab');
        if (wikiTab) {
          wikiTab.click();
        }

        document.getElementById('wiki-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-info" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading wiki page...</p>
          </div>
        `;

        const response = await fetch(`/api/wiki/${pageId}`);
        if (!response.ok) {
          throw new Error('Failed to load wiki page');
        }

        const pageData = await response.json();
        renderWikiPage(pageData);
      } catch (error) {
        console.error('Error loading wiki page:', error);
        document.getElementById('wiki-content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load wiki page</h5>
            <p>${error.message}</p>
            <button class="btn btn-primary" onclick="navigateTo('/wiki')">Back to Wiki</button>
          </div>
        `;
      }
    }

    function renderWikiPage(pageData) {
      const content = document.getElementById('wiki-content');

      // Render linked entities
      const linkedEntities = pageData.linked_entities || [];
      const entityLinks = linkedEntities.map(link => `
        <span class="badge bg-light text-dark me-1">
          <a href="#" onclick="navigateToEntity('${link.entity_type}', ${link.entity_id})" class="text-decoration-none">
            ${link.entity_type} #${link.entity_id}
          </a>
        </span>
      `).join('');

      content.innerHTML = `
        <div class="d-flex justify-content-between align-items-start mb-4">
          <div>
            <h2 class="mb-2">
              <i class="bi bi-book me-2 text-info"></i>${pageData.title}
            </h2>
            <div class="mb-3">
              <span class="badge bg-${pageData.status === 'Published' ? 'success' : 'warning'} me-2">${pageData.status}</span>
              <span class="badge bg-secondary me-2">${pageData.category || 'Uncategorized'}</span>
              <small class="text-muted">
                <i class="bi bi-chat me-1"></i>${pageData.comment_count || 0} comments
              </small>
            </div>
            ${pageData.summary ? `<p class="text-muted">${pageData.summary}</p>` : ''}
          </div>
          <div>
            <button class="btn btn-outline-secondary btn-sm" onclick="navigateTo('/wiki')">
              <i class="bi bi-arrow-left me-1"></i>Back to Wiki
            </button>
          </div>
        </div>

        ${pageData.tags && pageData.tags.length > 0 ? `
          <div class="mb-4">
            <strong>Tags:</strong>
            ${pageData.tags.map(tag => `<span class="badge bg-light text-dark me-1">${tag}</span>`).join('')}
          </div>
        ` : ''}

        ${linkedEntities.length > 0 ? `
          <div class="mb-4">
            <strong>Related Entities:</strong><br>
            ${entityLinks}
          </div>
        ` : ''}

        <div class="card">
          <div class="card-body">
            <div class="markdown-content">
              ${marked.parse(pageData.content)}
            </div>
          </div>
        </div>

        ${pageData.comment_count > 0 ? `
          <div class="mt-4">
            <h5>Comments (${pageData.comment_count})</h5>
            <div class="text-muted">Comments functionality coming soon...</div>
          </div>
        ` : ''}
      `;

      // Show content, hide loading
      document.getElementById('wiki-loading').classList.add('d-none');
      content.classList.remove('d-none');
    }

    function navigateToEntity(entityType, entityId) {
      // Switch to SDLC tab first
      const sdlcTab = document.getElementById('sdlc-tab');
      if (sdlcTab) {
        sdlcTab.click();
      }

      // Navigate to entity
      const routeMap = {
        'epic': '/epic/',
        'user_story': '/story/',
        'task': '/task/',
        'bug': '/bug/',
        'test_case': '/test-case/'
      };

      if (routeMap[entityType]) {
        navigateTo(routeMap[entityType] + entityId);
      }
    }

    function createWikiPage() {
      // For now, show a message. In a full implementation, this would open a modal or form
      alert('Wiki page creation is available through MCP tools. Use the create_wiki_page tool to create new wiki pages.');
    }

    // Load data when page loads and handle routing
    document.addEventListener('DOMContentLoaded', () => {
      loadData().then(() => {
        // Handle initial route
        const path = window.location.pathname;
        if (path !== '/' && path !== '/dashboard') {
          renderRoute(path);
        }
      });
    });
  </script>

  <!-- Comments Modal -->
  <div class="modal fade" id="commentsModal" tabindex="-1" aria-labelledby="commentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="commentsModalLabel">Comments</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="commentsContent">
          <!-- Comments will be loaded here -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>