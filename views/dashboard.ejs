    async function loadUserStoryForEdit(storyId) {
      try {
        const response = await fetch(`/api/story/${storyId}`);
        if (!response.ok) throw new Error('Failed to load user story');
        
        const story = await response.json();
        
        // Populate form fields
        document.getElementById('editUserStoryId').value = story.id;
        document.getElementById('editUserStoryTitle').value = story.title || '';
        document.getElementById('editUserStoryDescription').value = story.description || '';
        document.getElementById('editUserStoryPoints').value = story.story_points || '';
        document.getElementById('editUserStoryStatus').value = story.status || 'New';
        document.getElementById('editUserStoryAssignedTo').value = story.assigned_to || '';
      } catch (error) {
        console.error('Error loading user story for edit:', error);
        showEditToast('Failed to load user story', 'error');
      }
    }

    async function loadTaskForEdit(taskId) {
      try {
        const response = await fetch(`/api/task/${taskId}`);
        if (!response.ok) throw new Error('Failed to load task');
        
        const task = await response.json();
        
        // Populate form fields
        document.getElementById('editTaskId').value = task.id;
        document.getElementById('editTaskTitle').value = task.title || '';
        document.getElementById('editTaskDescription').value = task.description || '';
        document.getElementById('editTaskEstimatedHours').value = task.estimated_hours || '';
        document.getElementById('editTaskStatus').value = task.status || 'New';
        document.getElementById('editTaskPriority').value = task.priority || 'medium';
        document.getElementById('editTaskAssignedTo').value = task.assigned_to || '';
      } catch (error) {
        console.error('Error loading task for edit:', error);
        showEditToast('Failed to load task', 'error');
      }
    }

    async function saveUserStory() {
      const storyId = document.getElementById('editUserStoryId').value;
      const title = document.getElementById('editUserStoryTitle').value.trim();
      const description = document.getElementById('editUserStoryDescription').value.trim();
      const storyPoints = document.getElementById('editUserStoryPoints').value;

      // Basic validation
      if (!title) {
        showEditToast('Title is required', 'error');
        return;
      }

      if (title.length > 200) {
        showEditToast('Title must be less than 200 characters', 'error');
        return;
      }

      if (description && description.length > 10000) {
        showEditToast('Description must be less than 10000 characters', 'error');
        return;
      }

      if (storyPoints && (isNaN(storyPoints) || parseInt(storyPoints) < 0)) {
        showEditToast('Story points must be a positive number', 'error');
        return;
      }

      const formData = {
        title: title,
        description: description || null,
        story_points: storyPoints ? parseInt(storyPoints) : null
      };

      try {
        const response = await fetch(`/api/user-stories/${storyId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        const result = await response.json();
        
        if (response.ok && result.success) {
          showEditToast('User story updated successfully', 'success');
          
          // Close modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('editUserStoryModal'));
          modal.hide();
          
          // Refresh data
          await loadData();
        } else {
          showEditToast(result.error || 'Failed to update user story', 'error');
        }
      } catch (error) {
        console.error('Error saving user story:', error);
        showEditToast('Error saving user story', 'error');
      }
    }

    async function saveTask() {
      const taskId = document.getElementById('editTaskId').value;
      const title = document.getElementById('editTaskTitle').value.trim();
      const description = document.getElementById('editTaskDescription').value.trim();
      const estimatedHours = document.getElementById('editTaskEstimatedHours').value;
      const priority = document.getElementById('editTaskPriority').value;

      // Basic validation
      if (!title) {
        showEditToast('Title is required', 'error');
        return;
      }

      if (title.length > 200) {
        showEditToast('Title must be less than 200 characters', 'error');
        return;
      }

      if (description && description.length > 2000) {
        showEditToast('Description must be less than 2000 characters', 'error');
        return;
      }

      if (estimatedHours && (isNaN(estimatedHours) || parseFloat(estimatedHours) < 0)) {
        showEditToast('Estimated hours must be a positive number', 'error');
        return;
      }

      const formData = {
        title: title,
        description: description || null,
        estimated_hours: estimatedHours ? parseFloat(estimatedHours) : null,
        priority: priority
      };

      try {
        const response = await fetch(`/api/tasks/${taskId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        const result = await response.json();
        
        if (response.ok && result.success) {
          showEditToast('Task updated successfully', 'success');
          
          // Close modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('editTaskModal'));
          modal.hide();
          
          // Refresh data
          await loadData();
        } else {
          showEditToast(result.error || 'Failed to update task', 'error');
        }
      } catch (error) {
        console.error('Error saving task:', error);
        showEditToast('Error saving task', 'error');
      }
    }

    function showEditToast(message, type = 'info') {
      const toast = document.getElementById('archiveToast');
      const toastTitle = document.getElementById('archiveToastTitle');
      const toastMessage = document.getElementById('archiveToastMessage');
      const toastIcon = document.getElementById('archiveToastIcon');

      toastMessage.textContent = message;

      // Reset classes
      toastIcon.className = 'bi me-2';

      // Set styling based on type
      if (type === 'success') {
        toastTitle.textContent = 'Success';
        toastIcon.classList.add('bi-check-circle-fill', 'text-success');
        toast.classList.add('bg-success', 'text-white');
      } else if (type === 'error') {
        toastTitle.textContent = 'Error';
        toastIcon.classList.add('bi-exclamation-triangle-fill', 'text-danger');
        toast.classList.add('bg-danger', 'text-white');
      } else {
        toastTitle.textContent = 'Info';
        toastIcon.classList.add('bi-info-circle-fill', 'text-info');
      }

      const bsToast = new bootstrap.Toast(toast);
      bsToast.show();
    }

    // Add event listeners for save buttons
    document.addEventListener('DOMContentLoaded', () => {
      const saveUserStoryBtn = document.getElementById('saveUserStoryBtn');
      const saveTaskBtn = document.getElementById('saveTaskBtn');

      if (saveUserStoryBtn) {
        saveUserStoryBtn.addEventListener('click', saveUserStory);
      }

      if (saveTaskBtn) {
        saveTaskBtn.addEventListener('click', saveTask);
      }
    });
  </script>

