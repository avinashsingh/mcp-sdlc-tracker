<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    .status-badge {
      font-size: 0.75em;
      padding: 0.25em 0.5em;
    }
    .entity-card {
      transition: all 0.2s ease;
    }
    .entity-card:hover {
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .phase-indicator {
      font-size: 0.8em;
      opacity: 0.8;
    }
    .last-modified {
      font-size: 0.75em;
      color: #6c757d;
    }
    .hierarchy-level-1 { margin-left: 0; }
    .hierarchy-level-2 { margin-left: 2rem; }
    .hierarchy-level-3 { margin-left: 4rem; }
    .hierarchy-level-4 { margin-left: 6rem; }
    .markdown-content {
      line-height: 1.6;
    }
    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
      margin-top: 1rem;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .markdown-content p {
      margin-bottom: 1rem;
    }
    .markdown-content ul,
    .markdown-content ol {
      margin-bottom: 1rem;
      padding-left: 2rem;
    }
    .markdown-content li {
      margin-bottom: 0.25rem;
    }
    .markdown-content code {
      background-color: #f8f9fa;
      padding: 0.125rem 0.25rem;
      border-radius: 0.25rem;
      font-family: 'Courier New', monospace;
      font-size: 0.875em;
    }
    .markdown-content pre {
      background-color: #f8f9fa;
      padding: 1rem;
      border-radius: 0.25rem;
      overflow-x: auto;
      margin-bottom: 1rem;
    }
    .markdown-content pre code {
      background-color: transparent;
      padding: 0;
    }
    .markdown-content blockquote {
      border-left: 4px solid #dee2e6;
      padding-left: 1rem;
      margin-bottom: 1rem;
      color: #6c757d;
    }
    .markdown-content table {
      width: 100%;
      margin-bottom: 1rem;
      border-collapse: collapse;
    }
    .markdown-content th,
    .markdown-content td {
      padding: 0.5rem;
      border: 1px solid #dee2e6;
    }
    .markdown-content th {
      background-color: #f8f9fa;
      font-weight: 600;
    }
  </style>
</head>
<body class="bg-light">
  <div class="container-fluid py-4">
    <div class="row">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="h3 mb-0">
            <i class="bi bi-kanban text-primary me-2"></i>
            SDLC Tracker Dashboard
          </h1>
          <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
          </button>
        </div>

        <div id="loading" class="text-center py-5">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2 text-muted">Loading SDLC data...</p>
        </div>

        <div id="content" class="d-none">
          <!-- SDLC Hierarchy will be rendered here -->
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/lib/marked.umd.js"></script>
  <script>
    let epicsData = [];
    let currentRoute = '/';

    // Client-side routing
    const routes = {
      '/': showDashboard,
      '/epic/:id': showEpicDetails,
      '/story/:id': showStoryDetails,
      '/task/:id': showTaskDetails,
      '/bug/:id': showBugDetails,
      '/test-case/:id': showTestCaseDetails
    };

    function navigateTo(path) {
      window.history.pushState(null, '', path);
      currentRoute = path;
      renderRoute(path);
    }

    function renderRoute(path) {
      const route = Object.keys(routes).find(route => {
        const routeRegex = new RegExp('^' + route.replace(/:\w+/g, '(\\w+)') + '$');
        return routeRegex.test(path);
      });

      if (route) {
        const routeHandler = routes[route];
        const matches = path.match(new RegExp(route.replace(/:\w+/g, '(\\w+)')));
        const params = matches ? matches.slice(1) : [];
        routeHandler.apply(null, params);
      } else {
        showDashboard();
      }
    }

    // Handle browser back/forward
    window.addEventListener('popstate', () => {
      const path = window.location.pathname;
      renderRoute(path);
    });

    function renderMarkdown(text) {
      if (!text) return '';
      return marked.parse(text, {
        breaks: true,
        gfm: true
      });
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const diffTime = Math.abs(now - date);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      if (diffDays === 1) return 'today';
      if (diffDays === 2) return 'yesterday';
      if (diffDays <= 7) return `${diffDays - 1} days ago`;
      return date.toLocaleDateString();
    }

    function getStatusBadge(status) {
      const statusMap = {
        'New': 'secondary',
        'Open': 'info',
        'In Progress': 'primary',
        'Review': 'warning',
        'QA': 'info',
        'UAT': 'warning',
        'Fixed': 'success',
        'Closed': 'success',
        'Passed': 'success',
        'Failed': 'danger',
        'Critical': 'danger',
        'High': 'danger',
        'Medium': 'warning',
        'Low': 'secondary'
      };
      return statusMap[status] || 'secondary';
    }

    function getEntityIcon(type) {
      const iconMap = {
        'epic': 'bi-trophy',
        'user_story': 'bi-card-text',
        'task': 'bi-check-circle',
        'bug': 'bi-bug',
        'test_case': 'bi-clipboard-check'
      };
      return iconMap[type] || 'bi-circle';
    }

    function getEntityRoute(type) {
      const routeMap = {
        'epic': 'epic',
        'user_story': 'story',
        'task': 'task',
        'bug': 'bug',
        'test_case': 'test-case'
      };
      return routeMap[type] || type;
    }

    function createEntityCard(entity, type, level = 1, hasChildren = false) {
      const badgeClass = getStatusBadge(entity.status);
      const iconClass = getEntityIcon(type);
      const phaseInfo = entity.phase ? `<span class="phase-indicator ms-2"><i class="bi bi-diagram-3"></i> ${entity.phase}</span>` : '';
      const lastModified = formatDate(entity.updated_at);
      const entityId = `${type}_${entity.id}`;
      const route = getEntityRoute(type);

      // Comments indicator
      const commentCount = entity.comment_count || 0;
      const commentsInfo = commentCount > 0 ?
        `<span class="text-muted small ms-2 comments-link" style="cursor: pointer;" onclick="event.stopPropagation(); showComments('${type}', ${entity.id})" title="Click to view comments">
          <i class="bi bi-chat me-1"></i>${commentCount}
        </span>` : '';

      // Dependencies indicator (for user stories and epics)
      let dependenciesInfo = '';
      if ((type === 'user_story' || type === 'epic') && entity.dependencies && entity.dependencies.length > 0) {
        const entityType = type === 'user_story' ? 'storie' : 'epic';
        dependenciesInfo = `<span class="text-muted small ms-2" title="Depends on ${entity.dependencies.length} other ${entityType}(s)">
          <i class="bi bi-arrow-right-circle me-1"></i>${entity.dependencies.length}
        </span>`;
      }

      // Expand/collapse button
      const expandButton = hasChildren ?
        `<button class="btn btn-sm btn-outline-secondary me-2 expand-btn" data-bs-toggle="collapse" data-bs-target="#collapse_${entityId}" aria-expanded="true" onclick="event.stopPropagation()">
          <i class="bi bi-dash"></i>
        </button>` : '';

      return `
        <div class="card entity-card mb-2 hierarchy-level-${level}" onclick="navigateTo('/${route}/${entity.id}')" style="cursor: pointer;">
          <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center flex-grow-1">
                ${expandButton}
                <i class="bi ${iconClass} text-muted me-2"></i>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center mb-1">
                    <span class="fw-medium text-truncate">${entity.title || entity.description || `ID: ${entity.id}`}</span>
                    <span class="badge bg-${badgeClass} ms-2 status-badge">${entity.status}</span>
                    ${phaseInfo}
                    ${dependenciesInfo}
                    ${commentsInfo}
                  </div>
                  <div class="last-modified">
                    <i class="bi bi-clock me-1"></i>
                    Modified ${lastModified}
                  </div>
                </div>
              </div>
              ${entity.user_story_count !== undefined || entity.task_count !== undefined || entity.bug_count !== undefined || entity.test_case_count !== undefined ?
                `<div class="text-muted small">
                  ${entity.user_story_count !== undefined ? `<i class="bi bi-card-text me-1"></i>${entity.user_story_count}` : ''}
                  ${entity.task_count !== undefined ? `<i class="bi bi-check-circle ms-2 me-1"></i>${entity.task_count}` : ''}
                  ${entity.bug_count !== undefined ? `<i class="bi bi-bug ms-2 me-1"></i>${entity.bug_count}` : ''}
                  ${entity.test_case_count !== undefined ? `<i class="bi bi-clipboard-check ms-2 me-1"></i>${entity.test_case_count}` : ''}
                </div>` : ''}
            </div>
          </div>
        </div>
      `;
    }

    function renderSDLC() {
      const content = document.getElementById('content');
      let html = '';

      epicsData.forEach(epic => {
        const hasChildren = epic.userStories && epic.userStories.length > 0;
        html += createEntityCard(epic, 'epic', 1, hasChildren);

        if (hasChildren) {
          const epicCollapseId = `collapse_epic_${epic.id}`;
          html += `<div class="collapse show" id="${epicCollapseId}">`;
          html += `<div class="ms-4">`; // Indent children

          epic.userStories.forEach(userStory => {
            const hasUserStoryChildren = (userStory.tasks && userStory.tasks.length > 0) ||
                                       (userStory.bugs && userStory.bugs.length > 0) ||
                                       (userStory.testCases && userStory.testCases.length > 0);
            html += createEntityCard(userStory, 'user_story', 2, hasUserStoryChildren);

            if (hasUserStoryChildren) {
              const userStoryCollapseId = `collapse_user_story_${userStory.id}`;
              html += `<div class="collapse show" id="${userStoryCollapseId}">`;
              html += `<div class="ms-4">`; // Indent children

              // Tasks
              if (userStory.tasks && userStory.tasks.length > 0) {
                userStory.tasks.forEach(task => {
                  html += createEntityCard(task, 'task', 3, false);
                });
              }

              // Bugs
              if (userStory.bugs && userStory.bugs.length > 0) {
                userStory.bugs.forEach(bug => {
                  html += createEntityCard(bug, 'bug', 3, false);
                });
              }

              // Test Cases
              if (userStory.testCases && userStory.testCases.length > 0) {
                userStory.testCases.forEach(testCase => {
                  html += createEntityCard(testCase, 'test_case', 3, false);
                });
              }

              html += `</div>`; // End user story children indent
              html += `</div>`; // End user story collapse
            }
          });

          html += `</div>`; // End epic children indent
          html += `</div>`; // End epic collapse
        }
      });

      content.innerHTML = html;

      // Add event listeners for expand/collapse buttons
      document.querySelectorAll('.expand-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const icon = this.querySelector('i');
          if (icon) {
            icon.classList.toggle('bi-dash');
            icon.classList.toggle('bi-plus');
          }
        });
      });
    }

    // Route handlers
    function showDashboard() {
      document.title = 'SDLC Tracker Dashboard';
      renderSDLC();
    }

    async function showEpicDetails(epicId) {
      try {
        document.getElementById('content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading epic details...</p>
          </div>
        `;

        const response = await fetch(`/api/epic/${epicId}`);
        if (!response.ok) {
          throw new Error('Failed to load epic details');
        }

        const epic = await response.json();
        renderEntityDetail(epic, 'epic');
      } catch (error) {
        console.error('Error loading epic details:', error);
        document.getElementById('content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load epic details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showStoryDetails(storyId) {
      try {
        document.getElementById('content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading user story details...</p>
          </div>
        `;

        const response = await fetch(`/api/story/${storyId}`);
        if (!response.ok) {
          throw new Error('Failed to load story details');
        }

        const story = await response.json();
        renderEntityDetail(story, 'user_story');
      } catch (error) {
        console.error('Error loading story details:', error);
        document.getElementById('content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load user story details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showTaskDetails(taskId) {
      try {
        document.getElementById('content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading task details...</p>
          </div>
        `;

        const response = await fetch(`/api/task/${taskId}`);
        if (!response.ok) {
          throw new Error('Failed to load task details');
        }

        const task = await response.json();
        renderEntityDetail(task, 'task');
      } catch (error) {
        console.error('Error loading task details:', error);
        document.getElementById('content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load task details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showBugDetails(bugId) {
      try {
        document.getElementById('content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading bug details...</p>
          </div>
        `;

        const response = await fetch(`/api/bug/${bugId}`);
        if (!response.ok) {
          throw new Error('Failed to load bug details');
        }

        const bug = await response.json();
        renderEntityDetail(bug, 'bug');
      } catch (error) {
        console.error('Error loading bug details:', error);
        document.getElementById('content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load bug details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    async function showTestCaseDetails(testCaseId) {
      try {
        document.getElementById('content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading test case details...</p>
          </div>
        `;

        const response = await fetch(`/api/test-case/${testCaseId}`);
        if (!response.ok) {
          throw new Error('Failed to load test case details');
        }

        const testCase = await response.json();
        renderEntityDetail(testCase, 'test_case');
      } catch (error) {
        console.error('Error loading test case details:', error);
        document.getElementById('content').innerHTML = `
          <div class="alert alert-danger">
            <h5>Failed to load test case details</h5>
            <p>Please try again or go back to the dashboard.</p>
            <button class="btn btn-primary" onclick="navigateTo('/')">Back to Dashboard</button>
          </div>
        `;
      }
    }

    function renderEntityDetail(entity, entityType) {
      const statusBadge = getStatusBadge(entity.status);
      const entityIcon = getEntityIcon(entityType);
      const title = entity.title || entity.description || `ID: ${entity.id}`;

      document.title = `${title} - SDLC Tracker`;

      let attributesHtml = '';
      let relationshipsHtml = '';

      // Entity-specific attributes
      switch (entityType) {
        case 'epic':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Owner:</strong> ${entity.owner || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>User Stories:</strong> ${entity.user_story_count || 0}
              </div>
              ${entity.archived ? `
                <div class="col-md-6">
                  <strong>Archived:</strong>
                  <span class="badge bg-warning">Yes</span>
                  ${entity.archive_reason ? `<br><small class="text-muted">Reason: ${entity.archive_reason}</small>` : ''}
                </div>
              ` : ''}
            </div>
          `;
          break;

        case 'user_story':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Story Points:</strong> ${entity.story_points || 'Not set'}
              </div>
              <div class="col-md-6">
                <strong>Current Owner:</strong> ${entity.current_owner || 'Not assigned'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Epic:</strong> ${entity.epic_id ? `<a href="#" onclick="navigateTo('/epic/${entity.epic_id}')">Epic #${entity.epic_id}</a>` : 'None'}
              </div>
            </div>
            ${entity.acceptance_criteria ? `
              <div class="mb-3">
                <strong>Acceptance Criteria:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.acceptance_criteria}</div>
              </div>
            ` : ''}
            <div class="row mb-3">
              <div class="col-md-4">
                <strong>Tasks:</strong> ${entity.task_count || 0}
              </div>
              <div class="col-md-4">
                <strong>Bugs:</strong> ${entity.bug_count || 0}
              </div>
              <div class="col-md-4">
                <strong>Test Cases:</strong> ${entity.test_case_count || 0}
              </div>
            </div>
            ${entity.archived ? `
              <div class="mb-3">
                <strong>Archived:</strong>
                <span class="badge bg-warning ms-2">Yes</span>
                ${entity.archive_reason ? `<br><small class="text-muted">Reason: ${entity.archive_reason}</small>` : ''}
              </div>
            ` : ''}
          `;
          break;

        case 'task':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Estimated Hours:</strong> ${entity.estimated_hours || 'Not set'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Actual Hours:</strong> ${entity.actual_hours || 'Not set'}
              </div>
              <div class="col-md-6">
                <strong>User Story:</strong> ${entity.user_story_id ? `<a href="#" onclick="navigateTo('/story/${entity.user_story_id}')">Story #${entity.user_story_id}</a>` : 'None'}
              </div>
            </div>
          `;
          break;

        case 'bug':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Severity:</strong>
                <span class="badge bg-${getStatusBadge(entity.severity)}">${entity.severity}</span>
              </div>
              <div class="col-md-6">
                <strong>Reported By:</strong> ${entity.reported_by || 'Unknown'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>Created By:</strong> ${entity.created_by || 'Unknown'}
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>User Story:</strong> ${entity.user_story_id ? `<a href="#" onclick="navigateTo('/story/${entity.user_story_id}')">Story #${entity.user_story_id}</a>` : 'None'}
              </div>
              <div class="col-md-6">
                <strong>Task:</strong> ${entity.task_id ? `<a href="#" onclick="navigateTo('/task/${entity.task_id}')">Task #${entity.task_id}</a>` : 'None'}
              </div>
            </div>
          `;
          break;

        case 'test_case':
          attributesHtml = `
            <div class="row mb-3">
              <div class="col-md-6">
                <strong>Assigned To:</strong> ${entity.assigned_to || 'Not assigned'}
              </div>
              <div class="col-md-6">
                <strong>User Story:</strong> ${entity.user_story_id ? `<a href="#" onclick="navigateTo('/story/${entity.user_story_id}')">Story #${entity.user_story_id}</a>` : 'None'}
              </div>
            </div>
            ${entity.preconditions ? `
              <div class="mb-3">
                <strong>Preconditions:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.preconditions}</div>
              </div>
            ` : ''}
            ${entity.steps ? `
              <div class="mb-3">
                <strong>Steps:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.steps}</div>
              </div>
            ` : ''}
            ${entity.expected_result ? `
              <div class="mb-3">
                <strong>Expected Result:</strong>
                <div class="mt-2 p-3 bg-light rounded">${entity.expected_result}</div>
              </div>
            ` : ''}
          `;
          break;
      }

      const html = `
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="#" onclick="navigateTo('/')">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
              ${title}
            </li>
          </ol>
        </nav>

        <div class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <div>
              <h2 class="h4 mb-1">
                <i class="bi ${entityIcon} me-2"></i>
                ${title}
              </h2>
              <div class="text-muted small">
                <i class="bi bi-tag me-1"></i>${entityType.replace('_', ' ')} #${entity.id}
                <span class="badge bg-${statusBadge} ms-2">${entity.status}</span>
                ${entity.phase ? `<span class="badge bg-info ms-1">${entity.phase}</span>` : ''}
              </div>
            </div>
            <div class="text-end">
              <div class="small text-muted">
                Created: ${formatDate(entity.created_at)}<br>
                Updated: ${formatDate(entity.updated_at)}
              </div>
            </div>
          </div>

          <div class="card-body">
            ${entity.description ? `
              <div class="mb-4">
                <h6>Description</h6>
                <div class="markdown-content">${renderMarkdown(entity.description)}</div>
              </div>
            ` : ''}

            ${attributesHtml}

            ${entity.dependencies && entity.dependencies.length > 0 ? `
              <div class="mb-3">
                <strong>Dependencies:</strong>
                <div class="mt-2">
                  ${entity.dependencies.map(depId => {
                    const route = entityType === 'user_story' ? 'story' : 'epic';
                    const label = entityType === 'user_story' ? 'Story' : 'Epic';
                    return `<a href="#" onclick="navigateTo('/${route}/${depId}')" class="badge bg-info me-1">${label} #${depId}</a>`;
                  }).join('')}
                </div>
              </div>
            ` : ''}

            ${(entity.dependent_stories && entity.dependent_stories.length > 0) || (entity.dependent_epics && entity.dependent_epics.length > 0) ? `
              <div class="mb-3">
                <strong>Depended By:</strong>
                <div class="mt-2">
                  ${[
                    ...(entity.dependent_stories || []).map(depId => `<a href="#" onclick="navigateTo('/story/${depId}')" class="badge bg-secondary me-1">Story #${depId}</a>`),
                    ...(entity.dependent_epics || []).map(depId => `<a href="#" onclick="navigateTo('/epic/${depId}')" class="badge bg-secondary me-1">Epic #${depId}</a>`)
                  ].join('')}
                </div>
              </div>
            ` : ''}
          </div>
        </div>

        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
              <i class="bi bi-chat me-2"></i>
              Comments
            </h5>
            <button class="btn btn-sm btn-outline-primary" onclick="loadComments('${entityType}', ${entity.id})">
              <i class="bi bi-arrow-clockwise me-1"></i>
              Refresh
            </button>
          </div>
          <div class="card-body">
            <div id="comments-content">
              <div class="text-center py-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                  <span class="visually-hidden">Loading comments...</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;

      document.getElementById('content').innerHTML = html;
      loadComments(entityType, entity.id);
    }

    async function loadComments(entityType, entityId) {
      try {
        const response = await fetch(`/api/comments/${entityType}/${entityId}`);
        const comments = await response.json();

        const commentsHtml = comments.length === 0
          ? '<p class="text-muted mb-0">No comments yet.</p>'
          : comments.map(comment => `
              <div class="comment-item mb-3 p-3 bg-light rounded">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <strong class="text-primary">${comment.author}</strong>
                  <small class="text-muted">${formatDate(comment.created_at)}</small>
                </div>
                <div class="markdown-content">${renderMarkdown(comment.comment_text)}</div>
              </div>
            `).join('');

        document.getElementById('comments-content').innerHTML = commentsHtml;
      } catch (error) {
        console.error('Error loading comments:', error);
        document.getElementById('comments-content').innerHTML =
          '<div class="alert alert-warning">Failed to load comments.</div>';
      }
    }

    async function loadData() {
      try {
        const response = await fetch('/api/epics');
        if (!response.ok) {
          throw new Error('Failed to load data');
        }
        epicsData = await response.json();

        document.getElementById('loading').classList.add('d-none');
        document.getElementById('content').classList.remove('d-none');

        // Check if we're on the dashboard route
        if (window.location.pathname === '/' || window.location.pathname === '/dashboard') {
          renderSDLC();
        }
      } catch (error) {
        document.getElementById('loading').innerHTML = `
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Failed to load SDLC data. Please check if the database is initialized.
          </div>
        `;
        console.error('Error loading data:', error);
      }
    }

    // Load data when page loads and handle routing
    document.addEventListener('DOMContentLoaded', () => {
      loadData().then(() => {
        // Handle initial route
        const path = window.location.pathname;
        if (path !== '/' && path !== '/dashboard') {
          renderRoute(path);
        }
      });
    });
  </script>

  <!-- Comments Modal -->
  <div class="modal fade" id="commentsModal" tabindex="-1" aria-labelledby="commentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="commentsModalLabel">Comments</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="commentsContent">
          <!-- Comments will be loaded here -->
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</body>
</html>