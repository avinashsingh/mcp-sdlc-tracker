    // Wiki search functionality
    function performWikiSearch() {
      const query = document.getElementById('wiki-search-input').value.trim();
      if (!query) {
        clearWikiSearch();
        return;
      }

      const searchFields = [];
      if (document.getElementById('search-title').checked) searchFields.push('title');
      if (document.getElementById('search-content').checked) searchFields.push('content');
      if (document.getElementById('search-summary').checked) searchFields.push('summary');

      if (searchFields.length === 0) {
        alert('Please select at least one field to search in.');
        return;
      }

      const fuzzyThreshold = document.getElementById('fuzzy-threshold').value;
      const category = document.getElementById('search-category').value;
      const status = document.getElementById('search-status').value;

      // Show loading
      document.getElementById('wiki-content').innerHTML = `
        <div class="text-center py-5">
          <div class="spinner-border text-info" role="status">
            <span class="visually-hidden">Searching...</span>
          </div>
          <p class="mt-2 text-muted">Searching wiki pages...</p>
        </div>
      `;
      document.getElementById('wiki-content').classList.remove('d-none');

      // Build search URL
      const params = new URLSearchParams({
        q: query,
        fields: searchFields.join(','),
        fuzzy_threshold: fuzzyThreshold,
        limit: '20'
      });

      if (category) params.append('category', category);
      if (status) params.append('status', status);

      fetch(`/api/search/wiki?${params}`)
        .then(response => response.json())
        .then(data => {
          displayWikiSearchResults(data);
        })
        .catch(error => {
          console.error('Search error:', error);
          document.getElementById('wiki-content').innerHTML = `
            <div class="alert alert-danger">
              <h5>Search failed</h5>
              <p>${error.message}</p>
            </div>
          `;
        });
    }

    function displayWikiSearchResults(data) {
      const content = document.getElementById('wiki-content');

      if (!data.results || data.results.length === 0) {
        content.innerHTML = `
          <div class="text-center py-5">
            <i class="bi bi-search display-1 text-muted mb-3"></i>
            <h3>No results found</h3>
            <p class="text-muted">Try adjusting your search terms or fuzzy threshold.</p>
          </div>
        `;
        return;
      }

      const resultsHtml = data.results.map(page => {
        const titleHtml = page.title_highlight || page.title;
        const contentPreview = page.content_highlight ?
          page.content_highlight.substring(0, 200) + (page.content_highlight.length > 200 ? '...' : '') :
          (page.content || '').substring(0, 200) + ((page.content || '').length > 200 ? '...' : '');

        const relevancePercent = page.relevance || 0;

        return `
          <div class="card search-result-card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title mb-0">
                  <a href="#" onclick="navigateTo('/wiki/${page.id}')" class="text-decoration-none">
                    ${titleHtml}
                  </a>
                </h5>
                <div class="text-end">
                  <span class="badge bg-${page.status === 'Published' ? 'success' : page.status === 'Draft' ? 'warning' : 'secondary'}">${page.status}</span>
                  <div class="small text-muted mt-1">
                    Relevance: ${relevancePercent}%
                  </div>
                </div>
              </div>

              ${page.summary ? `<p class="card-text text-muted small">${page.summary_highlight || page.summary}</p>` : ''}

              ${contentPreview ? `<div class="content-preview mb-2">${contentPreview}</div>` : ''}

              <div class="d-flex justify-content-between align-items-center">
                <div class="small text-muted">
                  ${page.category ? `<span class="badge bg-light text-dark me-1">${page.category}</span>` : ''}
                  ${page.tags && page.tags.length > 0 ? page.tags.map(tag => `<span class="badge bg-light text-dark me-1">${tag}</span>`).join('') : ''}
                </div>
                <small class="text-muted">
                  <i class="bi bi-chat me-1"></i>${page.comment_count || 0}
                </small>
              </div>
            </div>
          </div>
        `;
      }).join('');

      content.innerHTML = `
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h4 class="mb-0">
            <i class="bi bi-search me-2"></i>
            Search Results for "${data.query}"
          </h4>
          <span class="badge bg-info">${data.total_results} results</span>
        </div>
        ${resultsHtml}
      `;
    }

    function clearWikiSearch() {
      document.getElementById('wiki-search-input').value = '';
      // Reset to show all wiki pages
      showWikiIndex();
    }

    // Update threshold display and add keyboard support
    document.addEventListener('DOMContentLoaded', () => {
      const thresholdSlider = document.getElementById('fuzzy-threshold');
      const thresholdValue = document.getElementById('threshold-value');
      const searchInput = document.getElementById('wiki-search-input');

      if (thresholdSlider && thresholdValue) {
        thresholdSlider.addEventListener('input', (e) => {
          thresholdValue.textContent = e.target.value;
        });
      }

      // Keyboard support for search
      if (searchInput) {
        searchInput.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            performWikiSearch();
          }
        });
      }

      // Show search section when wiki tab is active
      const wikiTab = document.getElementById('wiki-tab');
      if (wikiTab) {
        wikiTab.addEventListener('shown.bs.tab', () => {
          document.getElementById('wiki-search-section').classList.remove('d-none');
          // Focus search input
          setTimeout(() => {
            if (searchInput) searchInput.focus();
          }, 100);
        });
      }
    });

    // Load data when page loads and handle routing
    document.addEventListener('DOMContentLoaded', () => {
      // Sort controls
      document.querySelectorAll('input[name="sortBy"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
          currentSortBy = e.target.id.replace('sort-', '');
          applySorting();
        });
      });

      document.querySelectorAll('input[name="sortOrder"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
          currentSortOrder = e.target.id.replace('sort-', '');
          applySorting();
        });
      });

      loadData().then(() => {
        // Handle initial route
        const path = window.location.pathname;
        if (path !== '/' && path !== '/dashboard') {
          renderRoute(path);
        }
      });
    });

    // Global variable to store wiki page ID for archiving
    let wikiPageToArchive = null;

    // Archive Wiki Page Functions
    function archiveWikiPage(pageId, pageTitle) {
      wikiPageToArchive = pageId;
      document.getElementById('archiveWikiTitle').textContent = pageTitle;
      document.getElementById('archiveWikiReason').value = '';

      const modal = new bootstrap.Modal(document.getElementById('archiveWikiModal'));
      modal.show();
    }

    async function confirmArchiveWikiPage() {
      if (!wikiPageToArchive) return;

      const reason = document.getElementById('archiveWikiReason').value.trim();
      const confirmBtn = document.getElementById('confirmArchiveWikiBtn');

      // Disable button and show loading state
      confirmBtn.disabled = true;
      confirmBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Archiving...';

      try {
        // Prepare the request payload
        const payload = {
          wiki_page_id: wikiPageToArchive
        };
        if (reason) {
          payload.archive_reason = reason;
        }

        // Make the API call to archive the wiki page
        const response = await fetch('/api/archive-wiki', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Close modal
          const modal = bootstrap.Modal.getInstance(document.getElementById('archiveWikiModal'));
          modal.hide();

          // Show success message
          showArchiveToast('Wiki page archived successfully', 'success');

          // Refresh the current view after a short delay
          setTimeout(() => {
            const currentPath = window.location.pathname;
            if (currentPath.startsWith('/wiki/')) {
              // If we're on a wiki page detail, go back to wiki list
              navigateTo('/wiki');
            } else {
              // If we're on the wiki list, reload to update the list
              loadWikiPages();
            }
          }, 1500);
        } else {
          showArchiveToast('Failed to archive wiki page: ' + (result.error || 'Unknown error'), 'error');
        }
      } catch (error) {
        console.error('Error archiving wiki page:', error);
        showArchiveToast('Error archiving wiki page: ' + error.message, 'error');
      } finally {
        // Re-enable button and reset text
        confirmBtn.disabled = false;
        confirmBtn.innerHTML = '<i class="bi bi-archive me-1"></i>Archive Page';
        wikiPageToArchive = null;
      }
    }

    function showArchiveToast(message, type = 'info') {
      const toast = document.getElementById('archiveToast');
      const toastTitle = document.getElementById('archiveToastTitle');
      const toastMessage = document.getElementById('archiveToastMessage');
      const toastIcon = document.getElementById('archiveToastIcon');

      toastMessage.textContent = message;

      // Reset classes
      toastIcon.className = 'bi me-2';

      // Set styling based on type
      if (type === 'success') {
        toastTitle.textContent = 'Success';
        toastIcon.classList.add('bi-check-circle-fill', 'text-success');
        toast.classList.add('bg-success', 'text-white');
      } else if (type === 'error') {
        toastTitle.textContent = 'Error';
        toastIcon.classList.add('bi-exclamation-triangle-fill', 'text-danger');
        toast.classList.add('bg-danger', 'text-white');
      } else {
        toastTitle.textContent = 'Info';
        toastIcon.classList.add('bi-info-circle-fill', 'text-info');
      }

      const bsToast = new bootstrap.Toast(toast);
      bsToast.show();
    }

