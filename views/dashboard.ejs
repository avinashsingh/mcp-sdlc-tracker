        <div class="d-flex justify-content-between align-items-start mb-4">
          <div>
            <h2 class="mb-2">
              <i class="bi bi-book me-2 text-info"></i>${pageData.title}
            </h2>
            <div class="mb-3">
              <span class="badge bg-${pageData.status === 'Published' ? 'success' : 'warning'} me-2">${pageData.status}</span>
              <span class="badge bg-secondary me-2">${pageData.category || 'Uncategorized'}</span>
