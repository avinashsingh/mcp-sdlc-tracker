<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    .status-badge {
      font-size: 0.75em;
      padding: 0.25em 0.5em;
    }
    .entity-card {
      transition: all 0.2s ease;
    }
    .entity-card:hover {
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .phase-indicator {
      font-size: 0.8em;
      opacity: 0.8;
    }
    .last-modified {
      font-size: 0.75em;
      color: #6c757d;
    }
    .hierarchy-level-1 { margin-left: 0; }
    .hierarchy-level-2 { margin-left: 2rem; }
    .hierarchy-level-3 { margin-left: 4rem; }
    .hierarchy-level-4 { margin-left: 6rem; }
    .markdown-content {
      line-height: 1.6;
    }
    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
      margin-top: 1rem;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .markdown-content p {
      margin-bottom: 1rem;
    }
    .markdown-content ul,
    .markdown-content ol {
      margin-bottom: 1rem;
      padding-left: 2rem;
    }
    .markdown-content li {
      margin-bottom: 0.25rem;
    }
    .markdown-content code {
      background-color: #f8f9fa;
      padding: 0.125rem 0.25rem;
      border-radius: 0.25rem;
      font-family: 'Courier New', monospace;
      font-size: 0.875em;
    }
    .markdown-content pre {
      background-color: #f8f9fa;
      padding: 1rem;
      border-radius: 0.25rem;
      overflow-x: auto;
      margin-bottom: 1rem;
    }
    .markdown-content pre code {
      background-color: transparent;
      padding: 0;
    }
    .markdown-content blockquote {
      border-left: 4px solid #dee2e6;
      padding-left: 1rem;
      margin-bottom: 1rem;
      color: #6c757d;
    }
    .markdown-content table {
      width: 100%;
      margin-bottom: 1rem;
      border-collapse: collapse;
    }
    .markdown-content th,
    .markdown-content td {
      padding: 0.5rem;
      border: 1px solid #dee2e6;
    }
    .markdown-content th {
      background-color: #f8f9fa;
      font-weight: 600;
    }

    /* Priority/Severity badge styling */
    .badge.bg-danger {
      animation: pulse 2s infinite;
    }

    .badge.bg-warning {
      background: linear-gradient(45deg, #ffc107, #fd7e14);
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.7; }
      100% { opacity: 1; }
    }

    /* High priority items get subtle highlighting */
    .entity-card[data-priority="high"] {
      border-left: 4px solid #dc3545;
    }

    .entity-card[data-severity="Critical"] {
      border-left: 4px solid #dc3545;
      background: linear-gradient(90deg, rgba(220, 53, 69, 0.05) 0%, transparent 100%);
    }
  </style>
</head>
<body class="bg-light">
  <div class="container-fluid py-4">
    <div class="row">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h1 class="h3 mb-0">
            <i class="bi bi-kanban text-primary me-2"></i>
            SDLC Tracker Dashboard
          </h1>
          <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Refresh
          </button>
        </div>

        <!-- Navigation Tabs -->
        <ul class="nav nav-tabs mb-4" id="mainTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sdlc-tab" data-bs-toggle="tab" data-bs-target="#sdlc-panel" type="button" role="tab">
              <i class="bi bi-kanban me-2"></i>SDLC Tracker
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="wiki-tab" data-bs-toggle="tab" data-bs-target="#wiki-panel" type="button" role="tab" onclick="showWikiIndex()">
              <i class="bi bi-book me-2"></i>Wiki
            </button>
          </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="mainTabContent">
          <!-- SDLC Tab -->
          <div class="tab-pane fade show active" id="sdlc-panel" role="tabpanel">
            <div id="sdlc-loading" class="text-center py-5">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2 text-muted">Loading SDLC data...</p>
            </div>

            <div id="sdlc-content" class="d-none">
              <!-- Sorting Controls -->
              <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                  <strong>Sort by:</strong>
                  <div class="btn-group btn-group-sm ms-2" role="group">
                    <input type="radio" class="btn-check" name="sortBy" id="sort-updated" autocomplete="off" checked>
                    <label class="btn btn-outline-secondary btn-sm" for="sort-updated">Updated</label>

                    <input type="radio" class="btn-check" name="sortBy" id="sort-created" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-sm" for="sort-created">Created</label>

                    <input type="radio" class="btn-check" name="sortBy" id="sort-priority" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-sm" for="sort-priority">
                      <i class="bi bi-exclamation-triangle me-1"></i>Priority
                    </label>

                    <input type="radio" class="btn-check" name="sortBy" id="sort-status" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-sm" for="sort-status">Status</label>
                  </div>
                </div>

                <div>
                  <div class="btn-group btn-group-sm" role="group">
                    <input type="radio" class="btn-check" name="sortOrder" id="sort-desc" autocomplete="off" checked>
                    <label class="btn btn-outline-secondary btn-sm" for="sort-desc">
                      <i class="bi bi-sort-down"></i>
                    </label>

                    <input type="radio" class="btn-check" name="sortOrder" id="sort-asc" autocomplete="off">
                    <label class="btn btn-outline-secondary btn-sm" for="sort-asc">
                      <i class="bi bi-sort-up"></i>
                    </label>
                  </div>
                </div>
              </div>

              <!-- SDLC Hierarchy will be rendered here -->
            </div>
          </div>

          <!-- Wiki Tab -->
          <div class="tab-pane fade" id="wiki-panel" role="tabpanel">
            <div id="wiki-loading" class="text-center py-5">
              <div class="spinner-border text-info" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              <p class="mt-2 text-muted">Loading wiki pages...</p>
            </div>

            <!-- Wiki Search -->
            <div id="wiki-search-section" class="mb-4 d-none">
              <div class="card">
                <div class="card-body">
                  <div class="input-group mb-3">
                    <input type="text" id="wiki-search-input" class="form-control"
                           placeholder="Search wiki pages (supports fuzzy matching)">
                    <button class="btn btn-outline-primary" onclick="performWikiSearch()">
                      <i class="bi bi-search"></i> Search
                    </button>
                    <button class="btn btn-outline-secondary" onclick="clearWikiSearch()">
                      <i class="bi bi-x-circle"></i> Clear
                    </button>
                  </div>
                  <div class="row">
                    <div class="col-md-3">
                      <label class="form-label small">Search Fields</label>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="search-title" checked>
                        <label class="form-check-label small">Title</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="search-content" checked>
                        <label class="form-check-label small">Content</label>
                      </div>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="search-summary">
                        <label class="form-check-label small">Summary</label>
                      </div>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small">Fuzzy Threshold</label>
                      <input type="range" class="form-range" id="fuzzy-threshold" min="0" max="1" step="0.1" value="0.3">
                      <small class="text-muted" id="threshold-value">0.3</small>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small">Category</label>
                      <select class="form-select form-select-sm" id="search-category">
                        <option value="">All Categories</option>
                        <option value="technical">Technical</option>
                        <option value="process">Process</option>
                        <option value="business">Business</option>
                        <option value="qa">QA</option>
                        <option value="knowledge">Knowledge</option>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small">Status</label>
                      <select class="form-select form-select-sm" id="search-status">
                        <option value="">All Status</option>
                        <option value="Draft">Draft</option>
                        <option value="Published">Published</option>
                        <option value="Archived">Archived</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="wiki-content" class="d-none">
              <!-- Wiki pages will be rendered here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@12.0.2/lib/marked.umd.js"></script>
  <script>
    let epicsData = [];
    let wikiData = [];
    let currentRoute = '/';

    // Sorting variables
    let currentSortBy = 'updated_at';
    let currentSortOrder = 'desc';

    // Client-side routing
    const routes = {
      '/': showDashboard,
      '/epic/:id': showEpicDetails,
      '/story/:id': showStoryDetails,
      '/task/:id': showTaskDetails,
      '/bug/:id': showBugDetails,
      '/test-case/:id': showTestCaseDetails,
      '/wiki': showWikiIndex,
      '/wiki/:id': showWikiPage
    };

    function navigateTo(path) {
      window.history.pushState(null, '', path);
      currentRoute = path;
      renderRoute(path);
    }

    function renderRoute(path) {
      const route = Object.keys(routes).find(route => {
        const routeRegex = new RegExp('^' + route.replace(/:\w+/g, '(\\w+)') + '$');
        return routeRegex.test(path);
      });

      if (route) {
        const routeHandler = routes[route];
        const matches = path.match(new RegExp(route.replace(/:\w+/g, '(\\w+)')));
        const params = matches ? matches.slice(1) : [];
        routeHandler.apply(null, params);
      } else {
        showDashboard();
      }
    }

    // Handle browser back/forward
    window.addEventListener('popstate', () => {
      const path = window.location.pathname;
      renderRoute(path);
    });

    function renderMarkdown(text) {
      if (!text) return '';
      return marked.parse(text, {
        breaks: true,
        gfm: true
      });
    }

    function formatDate(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const diffTime = Math.abs(now - date);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      if (diffDays === 1) return 'today';
      if (diffDays === 2) return 'yesterday';
      if (diffDays <= 7) return `${diffDays - 1} days ago`;
      return date.toLocaleDateString();
    }

    function getStatusBadge(status) {
      const statusMap = {
        'New': 'secondary',
        'Open': 'info',
        'In Progress': 'primary',
        'Review': 'warning',
        'QA': 'info',
        'UAT': 'warning',
        'Fixed': 'success',
        'Closed': 'success',
        'Passed': 'success',
        'Failed': 'danger',
        'Critical': 'danger',
        'High': 'danger',
        'Medium': 'warning',
        'Low': 'secondary'
      };
      return statusMap[status] || 'secondary';
    }

    function getEntityIcon(type) {
      const iconMap = {
        'epic': 'bi-trophy',
        'user_story': 'bi-card-text',
        'task': 'bi-check-circle',
        'bug': 'bi-bug',
        'test_case': 'bi-clipboard-check'
      };
      return iconMap[type] || 'bi-circle';
    }

    function getEntityRoute(type) {
      const routeMap = {
        'epic': 'epic',
        'user_story': 'story',
        'task': 'task',
        'bug': 'bug',
        'test_case': 'test-case'
      };
      return routeMap[type] || type;
    }

    function getEntityTypeLabel(type) {
      const labelMap = {
        'epic': 'Epic',
        'user_story': 'User Story',
        'task': 'Task',
        'bug': 'Bug',
        'test_case': 'Test Case'
      };
      return labelMap[type] || type.replace('_', ' ');
    }

    function sortEntities(entities, sortBy, sortOrder) {
      return entities.sort((a, b) => {
        let aValue, bValue;

        switch (sortBy) {
          case 'priority':
            // Priority sorting: high > medium > low, severity: Critical > High > Medium > Low
            const priorityOrder = { 'high': 4, 'medium': 3, 'low': 2, '': 1 };
            const severityOrder = { 'Critical': 8, 'High': 7, 'Medium': 6, 'Low': 5, '': 1 };
            aValue = priorityOrder[a.priority] || severityOrder[a.severity] || 1;
            bValue = priorityOrder[b.priority] || severityOrder[b.severity] || 1;
            break;

          case 'status':
            // Status sorting: New > In Progress > Review > QA > UAT > Closed
            const statusOrder = {
              'New': 1, 'In Progress': 2, 'Review': 3, 'QA': 4, 'UAT': 5, 'Closed': 6,
              'Open': 1, 'Fixed': 5, 'Critical': 6, 'High': 5, 'Medium': 4, 'Low': 3
            };
            aValue = statusOrder[a.status] || 0;
            bValue = statusOrder[b.status] || 0;
            break;

          case 'created_at':
            aValue = new Date(a.created_at).getTime();
            bValue = new Date(b.created_at).getTime();
            break;

          case 'updated_at':
          default:
            aValue = new Date(a.updated_at).getTime();
            bValue = new Date(b.updated_at).getTime();
            break;
        }

        if (sortOrder === 'asc') {
          return aValue - bValue;
        } else {
          return bValue - aValue;
        }
      });
    }

    function applySorting() {
      // Re-sort epicsData and re-render
      epicsData.forEach(epic => {
        if (epic.userStories) {
          epic.userStories = sortEntities(epic.userStories, currentSortBy, currentSortOrder);

          epic.userStories.forEach(story => {
            if (story.tasks) story.tasks = sortEntities(story.tasks, currentSortBy, currentSortOrder);
            if (story.bugs) story.bugs = sortEntities(story.bugs, currentSortBy, currentSortOrder);
            if (story.testCases) story.testCases = sortEntities(story.testCases, currentSortBy, currentSortOrder);
          });
        }
      });

      renderSDLC();
    }

    function createEntityCard(entity, type, level = 1, hasChildren = false) {
      const badgeClass = getStatusBadge(entity.status);
      const iconClass = getEntityIcon(type);
      const phaseInfo = entity.phase ? `<span class="phase-indicator ms-2"><i class="bi bi-diagram-3"></i> ${entity.phase}</span>` : '';
      const lastModified = formatDate(entity.updated_at);
      const entityId = `${type}_${entity.id}`;
      const route = getEntityRoute(type);

      // Comments indicator
      const commentCount = entity.comment_count || 0;
      const commentsInfo = commentCount > 0 ?
        `<span class="text-muted small ms-2 comments-link" style="cursor: pointer;" onclick="event.stopPropagation(); showComments('${type}', ${entity.id})" title="Click to view comments">
          <i class="bi bi-chat me-1"></i>${commentCount}
        </span>` : '';

      // Dependencies indicator (for user stories, epics, and tasks)
      let dependenciesInfo = '';
      if ((type === 'user_story' || type === 'epic') && entity.dependencies && entity.dependencies.length > 0) {
        const entityType = type === 'user_story' ? 'storie' : 'epic';
        dependenciesInfo = `<span class="text-muted small ms-2" title="Depends on ${entity.dependencies.length} other ${entityType}(s)">
          <i class="bi bi-arrow-right-circle me-1"></i>${entity.dependencies.length}
        </span>`;
      } else if (type === 'task' && entity.dependencies && entity.dependencies.length > 0) {
        dependenciesInfo = `<span class="text-muted small ms-2" title="Depends on ${entity.dependencies.length} other task(s)">
          <i class="bi bi-arrow-right-circle me-1"></i>${entity.dependencies.length}
        </span>`;
      }

      // Priority/Severity badge
      let prioritySeverityBadge = '';
      if (type === 'task' && entity.priority) {
        const priorityColors = {
          'high': 'danger',
          'medium': 'warning',
          'low': 'info'
        };
        const priorityIcons = {
          'high': 'bi-exclamation-triangle-fill',
          'medium': 'bi-dash-circle-fill',
          'low': 'bi-arrow-down-circle-fill'
        };
        prioritySeverityBadge = `<span class="badge bg-${priorityColors[entity.priority]} ms-1" title="Priority: ${entity.priority}">
          <i class="bi ${priorityIcons[entity.priority]} me-1"></i>${entity.priority}
        </span>`;
      } else if (type === 'bug' && entity.severity) {
        const severityColors = {
          'Critical': 'danger',
          'High': 'danger',
          'Medium': 'warning',
          'Low': 'secondary'
        };
        prioritySeverityBadge = `<span class="badge bg-${severityColors[entity.severity]} ms-1" title="Severity: ${entity.severity}">
          <i class="bi bi-bug-fill me-1"></i>${entity.severity}
        </span>`;
      }

      // Expand/collapse button
      const expandButton = hasChildren ?
        `<button class="btn btn-sm btn-outline-secondary me-2 expand-btn" data-bs-toggle="collapse" data-bs-target="#collapse_${entityId}" aria-expanded="true" onclick="event.stopPropagation()">
          <i class="bi bi-dash"></i>
        </button>` : '';

      // Edit button for user stories and tasks
      const editButton = (type === 'user_story' || type === 'task') ?
        `<button class="btn btn-sm btn-outline-primary me-2" onclick="event.stopPropagation(); openEditModal('${type}', ${entity.id})" title="Edit ${getEntityTypeLabel(type)}">
          <i class="bi bi-pencil"></i>
        </button>` : '';

      // Data attributes for priority highlighting
      const dataAttrs = [];
      if (type === 'task' && entity.priority === 'high') {
        dataAttrs.push('data-priority="high"');
      } else if (type === 'bug' && entity.severity === 'Critical') {
        dataAttrs.push('data-severity="Critical"');
      }
      const dataAttrString = dataAttrs.length > 0 ? ' ' + dataAttrs.join(' ') : '';

      return `
        <div class="card entity-card mb-2 hierarchy-level-${level}${dataAttrString}" onclick="navigateTo('/${route}/${entity.id}')" style="cursor: pointer;">
          <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center flex-grow-1">
                ${expandButton}
                ${editButton}
                <i class="bi ${iconClass} text-muted me-2"></i>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center mb-1">
                    <span class="fw-medium text-truncate">${getEntityTypeLabel(type)} #${entity.id}${entity.title || entity.description ? ': ' + (entity.title || entity.description) : ''}</span>
                    <span class="badge bg-${badgeClass} ms-2 status-badge">${entity.status}</span>
                    ${prioritySeverityBadge}
                    ${phaseInfo}
                    ${dependenciesInfo}
                    ${commentsInfo}
                  </div>
                  <div class="last-modified">
                    <i class="bi bi-clock me-1"></i>
                    Modified ${lastModified}
                  </div>
                </div>
              </div>
              ${entity.user_story_count !== undefined || entity.task_count !== undefined || entity.bug_count !== undefined || entity.test_case_count !== undefined ?
                `<div class="text-muted small">
                  ${entity.user_story_count !== undefined ? `<i class="bi bi-card-text me-1"></i>${entity.user_story_count}` : ''}
                  ${entity.task_count !== undefined ? `<i class="bi bi-check-circle ms-2 me-1"></i>${entity.task_count}` : ''}
                  ${entity.bug_count !== undefined ? `<i class="bi bi-bug ms-2 me-1"></i>${entity.bug_count}` : ''}
                  ${entity.test_case_count !== undefined ? `<i class="bi bi-clipboard-check ms-2 me-1"></i>${entity.test_case_count}` : ''}
                </div>` : ''}
            </div>
          </div>
        </div>
      `;
    }

    function renderSDLC() {
      const content = document.getElementById('sdlc-content');
      let html = '';

      epicsData.forEach(epic => {
        const hasChildren = epic.userStories && epic.userStories.length > 0;
        html += createEntityCard(epic, 'epic', 1, hasChildren);

        if (hasChildren) {
          const epicCollapseId = `collapse_epic_${epic.id}`;
          html += `<div class="collapse show" id="${epicCollapseId}">`;
          html += `<div class="ms-4">`; // Indent children

          epic.userStories.forEach(userStory => {
            const hasUserStoryChildren = (userStory.tasks && userStory.tasks.length > 0) ||
                                       (userStory.bugs && userStory.bugs.length > 0) ||
                                       (userStory.testCases && userStory.testCases.length > 0);
            html += createEntityCard(userStory, 'user_story', 2, hasUserStoryChildren);

            if (hasUserStoryChildren) {
              const userStoryCollapseId = `collapse_user_story_${userStory.id}`;
              html += `<div class="collapse show" id="${userStoryCollapseId}">`;
              html += `<div class="ms-4">`; // Indent children

              // Tasks
              if (userStory.tasks && userStory.tasks.length > 0) {
                userStory.tasks.forEach(task => {
                  html += createEntityCard(task, 'task', 3, false);
                });
              }

              // Bugs
              if (userStory.bugs && userStory.bugs.length > 0) {
                userStory.bugs.forEach(bug => {
                  html += createEntityCard(bug, 'bug', 3, false);
                });
              }

              // Test Cases
              if (userStory.testCases && userStory.testCases.length > 0) {
                userStory.testCases.forEach(testCase => {
                  html += createEntityCard(testCase, 'test_case', 3, false);
                });
              }

              html += `</div>`; // End user story children indent
              html += `</div>`; // End user story collapse
            }
          });

          html += `</div>`; // End epic children indent
          html += `</div>`; // End epic collapse
        }
      });

      content.innerHTML = html;

      // Add event listeners for expand/collapse buttons
      document.querySelectorAll('.expand-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const icon = this.querySelector('i');
          if (icon) {
            icon.classList.toggle('bi-dash');
            icon.classList.toggle('bi-plus');
          }
        });
      });
    }

    // Route handlers
    function showDashboard() {
      document.title = 'SDLC Tracker Dashboard';

      // Switch to SDLC tab
      const sdlcTab = document.getElementById('sdlc-tab');
      const wikiTab = document.getElementById('wiki-tab');
      if (sdlcTab && wikiTab) {
        sdlcTab.classList.add('active');
        wikiTab.classList.remove('active');
        document.getElementById('sdlc-panel').classList.add('show', 'active');
        document.getElementById('wiki-panel').classList.remove('show', 'active');
      }

      renderSDLC();
    }

    async function showEpicDetails(epicId) {
      try {
        document.getElementById('sdlc-content').innerHTML = `
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading epic details...</p>
          </div>
        `;

        const response = await fetch(`/api/epic/${epicId}`);
        if (!response.ok) {
